						},
						"url": {
							"raw": "{{baseUrl}}/projects/import/github",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"projects",
								"import",
								"github"
							]
						}
					}
				},
				{
					"name": "Import Project from GitHub",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"repoUrl\": \"https://github.com/nestjs/nest\",\n    \"status\": \"draft\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/projects/import/github",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"projects",
								"import",
								"github"
							]
						},
						"description": "Imports a GitHub repository and auto-fetches title, description, languages, tags, technologies, and statistics. Supports saving as unpublished (draft) or published."
					},
					"response": []
				}
