		{
			"name": "Applications",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const requestId = pm.environment.get('contributionRequestId');",
							"const uuidV4 = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
							"if (!uuidV4.test(requestId || '')) {",
							"  pm.environment.set('contributionRequestId', 'e9f13368-6922-4b96-9bb3-51bba1ac632e');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"item": [
				{
					"name": "01 - Login Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"if (body.tokens) {",
									"  pm.environment.set('ownerAccessToken', body.tokens.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "02 - Login Contributor",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"if (body.tokens) {",
									"  pm.environment.set('contributorAccessToken', body.tokens.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{contributorEmail}}\",\n  \"password\": \"{{contributorPassword}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "03 - Submit Application",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"  const body = pm.response.json();",
									"  pm.environment.set('applicationId', body.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{contributorAccessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"contributionApproach\": \"I will implement and test the requested NestJS workflow.\",\n  \"proposedDeliveryDurationDays\": 5,\n  \"idempotencyKey\": \"{{applicationIdempotencyKey}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/tasks/{{contributionRequestId}}/applications",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "{{contributionRequestId}}", "applications"]
						},
						"description": "Submit one Application as an active contributor. Reuse applicationIdempotencyKey to test replay behavior."
					}
				},
				{
					"name": "04 - List Request Applications as Owner",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{ownerAccessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/tasks/{{contributionRequestId}}/applications",
							"host": ["{{baseUrl}}"],
