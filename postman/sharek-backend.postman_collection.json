							"host": ["{{baseUrl}}"],
							"path": ["applications", "{{applicationId}}", "withdraw"]
						},
						"description": "Withdraw a pending Application as its contributor. Reuse withdrawalIdempotencyKey to test replay behavior."
					}
				}
