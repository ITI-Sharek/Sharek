				{
					"name": "Verify Email",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json && json.tokens) {",
									"  pm.environment.set('accessToken', json.tokens.accessToken);",
									"  pm.environment.set('refreshToken', json.tokens.refreshToken);",
									"  if (json.user && json.user.id) {",
									"    pm.environment.set('userId', json.user.id);",
									"  }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify-email",
