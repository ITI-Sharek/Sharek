# Shared local defaults.
# Copy this file to `.env` and change only the values your machine needs.
# Do not put real production secrets here.

NODE_ENV=development
PORT=3000
API_HOST_PORT=3000
PRISMA_STUDIO_PORT=5555
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Docker database defaults.
DATABASE_URL=postgresql://sharek:sharek@postgres:5432/sharek?schema=public
POSTGRES_USER=sharek
POSTGRES_PASSWORD=sharek
POSTGRES_DB=sharek
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# Local-only placeholder secrets.
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret

# Teammate-specific values.
# Use a shared development GitHub OAuth app or create your own local app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/github/oauth/callback
GITHUB_TOKEN_ENCRYPTION_KEY=change-this-github-token-encryption-key-32-chars-min

# Separate FastAPI AI service.
AI_SERVICE_URL=http://host.docker.internal:8000
AI_SERVICE_TIMEOUT_MS=5000
AI_SERVICE_AUTH_TOKEN=
AI_LOW_CONFIDENCE_THRESHOLD=0.70
