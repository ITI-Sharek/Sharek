NODE_ENV=development
PORT=4000
PRISMA_STUDIO_PORT=5555

DATABASE_URL=postgresql://sharek:sharek@postgres:5432/sharek?schema=public
POSTGRES_USER=sharek
POSTGRES_PASSWORD=sharek
POSTGRES_DB=sharek
POSTGRES_PORT=5433

REDIS_URL=redis://redis:6379
REDIS_PORT=6379
# Paymob sandbox foundation. Disabled until the product and account gates in
# DEC-077 are closed. Never commit real credentials.
PAYMENTS_PAYMOB_ENABLED=false
PAYMOB_API_BASE_URL=https://accept.paymob.com
PAYMOB_INTENTION_PATH=/v1/intention/
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_NOTIFICATION_URL=https://<public-backend>/payments/paymob/webhook
PAYMOB_REDIRECTION_URL=https://<public-frontend>/payments/result
PAYMOB_EXPECTED_LIVE=false
# Comma-separated Paymob integration IDs, required only when enabled.
PAYMOB_INTEGRATION_IDS=
PAYMOB_REQUEST_TIMEOUT_MS=10000
# The authenticated /realtime WebSocket is enabled after the coordinated
# client cutover. Set false only when intentionally running HTTP-only mode;
# Redis failure does not invalidate committed HTTP Notification writes.
REALTIME_NOTIFICATIONS_ENABLED=true
NOTIFICATION_EVENT_RECOVERY_QUEUE_ENABLED=true
NOTIFICATION_EVENT_RECOVERY_INTERVAL_MS=60000
NOTIFICATION_EVENT_RECOVERY_BATCH_SIZE=100
NOTIFICATION_EVENT_MAX_PUBLISH_ATTEMPTS=5
NOTIFICATION_RETENTION_QUEUE_ENABLED=true
NOTIFICATION_RETENTION_INTERVAL_MS=60000
NOTIFICATION_RETENTION_BATCH_SIZE=100
SKILL_PROFILE_QUEUE_ENABLED=true
SKILL_PROFILE_QUEUE_CONCURRENCY=2
APPLICATION_REVIEW_QUEUE_ENABLED=true
DELIVERY_REPUTATION_QUEUE_ENABLED=true
ADVISORY_FIT_QUEUE_ENABLED=true
ADVISORY_FIT_REAP_INTERVAL_MS=60000
ADVISORY_FIT_STALE_AFTER_MS=600000

# Required-skill-level inference (DEC-078). Turning the queue off is supported,
# not degraded: the owner writes the set through
# PUT /contribution-requests/:requestId/skill-requirements and publishes as usual.
REQUIREMENT_INFERENCE_QUEUE_ENABLED=true
# The Proposal-side gate (P0-B04). Needs a live AI service on the request
# thread, unlike the draft path which queues. Off means proposals submit
# ungated, exactly as they did before Phase 0.
PROPOSAL_ELIGIBILITY_GATE_ENABLED=true

# Block-triggered skill-gap guidance (P0-B05). With the queue off, a guidance
# request still records the blocking skills and returns them; only the narrative
# never arrives. The reason a contributor was blocked never depended on the AI.
ELIGIBILITY_GUIDANCE_QUEUE_ENABLED=true
AI_REQUIREMENT_INFERENCE_PATH=/requirements/infer
AI_REQUIREMENT_INFERENCE_TIMEOUT_MS=60000

# Safe Materials. Formats and limits are configuration, not constants.
MATERIAL_STORAGE_ROOT=./.material-storage
MATERIAL_MAX_BYTES=26214400
MATERIAL_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/markdown,text/plain
MATERIAL_SCAN_QUEUE_ENABLED=true
MATERIAL_SCAN_REAP_INTERVAL_MS=60000
MATERIAL_SCAN_STALE_AFTER_MS=600000
MATERIAL_SCAN_MAX_ATTEMPTS=3
# Stand-in for a real scanner. `content` reports the EICAR test file as
# infected and everything else as clean; `clean`, `infected` and `error` force
# a verdict so an operator can reproduce one on demand.
MATERIAL_SCANNER_STUB_MODE=content
# Signs short-lived download links. Must not be the JWT access secret: a
# download link is deliberately far weaker than a session token.
MATERIAL_DOWNLOAD_TOKEN_SECRET=change-me-material-download-secret
MATERIAL_DOWNLOAD_TOKEN_TTL_SECONDS=300
# S3 chat attachments (Slice 3). A new, narrow blast radius: only chat
# attachments go through S3. Materials keep local disk.
CHAT_ATTACHMENTS_ENABLED=false
CHAT_ATTACHMENT_MAX_BYTES=26214400
CHAT_ATTACHMENT_MAX_PER_MESSAGE=5
CHAT_ATTACHMENT_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document
CHAT_ATTACHMENT_UPLOAD_INTENT_TTL_SECONDS=1800
CHAT_ATTACHMENT_UPLOADS_PER_MINUTE=20
CHAT_ATTACHMENT_SCAN_QUEUE_ENABLED=true
CHAT_ATTACHMENT_SCAN_REAP_INTERVAL_MS=60000
CHAT_ATTACHMENT_SCAN_STALE_AFTER_MS=600000
CHAT_ATTACHMENT_SCAN_MAX_ATTEMPTS=3
CHAT_ATTACHMENT_SCANNER_STUB_MODE=content
CHAT_ATTACHMENT_EVENT_MAX_PUBLISH_ATTEMPTS=5
CHAT_ATTACHMENT_DOWNLOAD_URL_TTL_SECONDS=60
CHAT_ATTACHMENT_RETENTION_MONTHS=12
CHAT_ATTACHMENT_RETENTION_WARNING_DAYS=30
S3_REGION=us-east-1
S3_CHAT_ATTACHMENTS_BUCKET=
S3_CHAT_ATTACHMENTS_KEY_PREFIX=chat-attachments/
# MinIO for local dev; empty = real AWS.
S3_ENDPOINT=http://minio:9000
# Browser-facing MinIO endpoint. The API signs with this host so the browser
# does not receive the Docker-only `minio` hostname.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Empty in production is CORRECT (IAM role via the SDK default provider chain).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO without KMS cannot accept an SSE request; leave empty locally.
# Production may set AES256 or aws:kms.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
S3_REQUEST_TIMEOUT_MS=15000
# P2P WebRTC Assignment Calls (Slice 4, ADR 0016). NestJS mints ICE server
# credentials; media flows directly between the two browsers, or through a
# TURN relay when it must.
ASSIGNMENT_CALLS_ENABLED=false
ASSIGNMENT_CALL_RING_TIMEOUT_MS=30000
ASSIGNMENT_CALL_RECONNECT_GRACE_MS=30000
ASSIGNMENT_CALL_MAX_DURATION_MS=3600000
ASSIGNMENT_CALL_WARNING_MS=3000000,3480000
ASSIGNMENT_CALL_QUEUE_ENABLED=true
ASSIGNMENT_CALL_SWEEP_INTERVAL_MS=60000
ASSIGNMENT_CALL_EVENT_MAX_PUBLISH_ATTEMPTS=5
ASSIGNMENT_CALL_SIGNAL_MAX_SDP_BYTES=65536
ASSIGNMENT_CALL_SIGNALS_PER_10S=60
# Signs ephemeral coturn REST-scheme TURN credentials (RFC 7635); never sent
# to the browser. Required (min 32 chars) once ASSIGNMENT_CALLS_ENABLED=true.
TURN_STATIC_AUTH_SECRET=
TURN_REALM=sharek.local
# coturn for local dev; a managed TURN provider (Cloudflare Realtime TURN,
# Twilio NTS as fallback) in production -- never self-hosted there.
TURN_URLS=turn:coturn:3478?transport=udp,turn:coturn:3478?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=300
TURN_MONTHLY_BUDGET_BYTES=53687091200
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

APPLICATION_REVIEW_SWEEP_INTERVAL_MS=60000
APPLICATION_REVIEW_SWEEP_BATCH_SIZE=100
DELIVERY_REPUTATION_SWEEP_INTERVAL_MS=60000
# Production allowlist. Development reflects any requesting origin so local,
# mobile, and LAN clients can call the credentialed API without CORS failures.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
FRONTEND_URL=http://localhost:3001

GITHUB_CLIENT_ID=
GITHUB_API_URL=https://api.github.com
GITHUB_API_OVERALL_TIMEOUT_MS=8000
GITHUB_API_REQUEST_TIMEOUT_MS=8000
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/auth/github/callback/repository
GITHUB_AUTH_CALLBACK_URL=http://localhost:4000/auth/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=change-this-github-token-encryption-key-32-chars-min

# Repository evidence GitHub App. These settings are separate from GitHub
# social login and the legacy repository OAuth App above.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Base64-encoded PEM. Do not commit a real private key.
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
# Optional local Smee channel URL; never used as the production webhook URL.
GITHUB_APP_WEBHOOK_PROXY_URL=
GITHUB_APP_SLUG=
GITHUB_APP_INSTALLATION_URL=https://github.com/apps/your-app-slug/installations/new
GITHUB_APP_CALLBACK_URL=http://localhost:4000/auth/github/app/callback
GITHUB_APP_FRONTEND_RETURN_URL=http://localhost:3001/settings?section=github

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/auth/google/callback


# Email verification OTP delivery.
# For Gmail, use SMTP_HOST=smtp.gmail.com and a Google App Password in SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Separate FastAPI AI service.
AI_SERVICE_URL=http://host.docker.internal:8010
AI_SERVICE_TIMEOUT_MS=60000
AI_ADVISORY_FIT_TIMEOUT_MS=75000
AI_SKILL_GAP_GUIDANCE_PATH=/gap-guidance/generate
AI_SKILL_GAP_GUIDANCE_TIMEOUT_MS=75000
AI_MATERIAL_ANALYSIS_PATH=/material-analysis/analyze
AI_MATERIAL_ANALYSIS_TIMEOUT_MS=135000
AI_CONTRIBUTOR_MATCHING_PATH=/contributor-matching/generate
AI_CONTRIBUTOR_MATCHING_TIMEOUT_MS=75000
AI_SERVICE_AUTH_TOKEN=replace-with-the-same-long-random-token-used-by-fastapi
AI_LOW_CONFIDENCE_THRESHOLD=0.70
# Separate feature/entitlement gate for owner-authorized Material analysis.
MATERIAL_ANALYSIS_ENABLED=true
MATERIAL_ANALYSIS_REQUIRE_SUBSCRIPTION=false
MATERIAL_ANALYSIS_MIN_PLAN=gold
MATERIAL_ANALYSIS_MAX_DOCUMENTS=5
MATERIAL_ANALYSIS_MAX_EXTRACTED_CHARACTERS=250000
MATERIAL_ANALYSIS_QUEUE_ENABLED=true
MATERIAL_ANALYSIS_REAP_INTERVAL_MS=60000
MATERIAL_ANALYSIS_STALE_AFTER_MS=600000
