PATCH {{baseUrl}}/me/notification-preferences
Authorization: Bearer {{ownerLogin.response.body.$.tokens.accessToken}}
Content-Type: application/json

{
  "expectedRevision": 1,
  "retentionDays": 90,
  "quietHours": {
    "enabled": false,
    "startLocal": null,
    "endLocal": null,
    "timeZone": null
  }
}


