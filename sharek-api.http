### 40 - List the authenticated user's Notifications
# The recipient is derived from the access token. Use an opaque nextCursor from
# this response for the next page; do not construct cursors manually.
# @name ownerNotifications
GET {{baseUrl}}/notifications?limit=20
Authorization: Bearer {{ownerLogin.response.body.$.tokens.accessToken}}


### 41 - Read the authenticated user's unread Notification count
GET {{baseUrl}}/notifications/unread-count
Authorization: Bearer {{ownerLogin.response.body.$.tokens.accessToken}}


### 42 - Mark one Notification read
# Replace notificationId with an item returned by the recipient's list call.
PATCH {{baseUrl}}/notifications/{{notificationId}}/read-state
Authorization: Bearer {{ownerLogin.response.body.$.tokens.accessToken}}
Content-Type: application/json

{
  "state": "read"
}


### 43 - Mark one Notification unread
PATCH {{baseUrl}}/notifications/{{notificationId}}/read-state
Authorization: Bearer {{ownerLogin.response.body.$.tokens.accessToken}}
Content-Type: application/json

{
  "state": "unread"
}


### 44 - Mark all retained Notifications read
POST {{baseUrl}}/notifications/mark-all-read
Authorization: Bearer {{ownerLogin.response.body.$.tokens.accessToken}}
Content-Type: application/json

{}


