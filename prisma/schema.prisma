generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  contributor
  admin
}

enum UserStatus {
  pending
  active
  suspended
  deactivated
}

enum AuthProvider {
  github
  google
}

enum LanguageCode {
  ar
  en
}

enum SubscriptionPlanType {
  bronze
  silver
  gold
}

enum SubscriptionUserRoleContext {
  owner
  contributor
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

enum ProjectCategory {
  web
  mobile
  ai_ml
  devops
  tools_utilities
}

enum ProjectDifficulty {
  beginner
  intermediate
  advanced
}

enum ProjectStatus {
  draft
  published
  archived
}

enum ContributionRequestDifficulty {
  beginner
  intermediate
  advanced
}

enum ContributionRequestStatus {
  draft
  published
  assigned
  completed
  cancelled
  discarded
}

enum ContributionRequestRequirementKind {
  required
  preferred
}

enum ContributionRequestAuditAction {
  created
  updated
  published
  cancelled
  discarded
}

enum ApplicationStatus {
  pending_owner_review
  accepted
  declined_by_owner
  not_selected
  expired
  withdrawn
  request_cancelled
}

enum ApplicationAuditAction {
  submitted
  withdrawn
  request_cancelled
}

enum DeliveryStatus {
  submitted
  under_review
  approved
  rejected
  revision_requested
}

enum DeliveryReviewOutcome {
  approved
  rejected
  revision_requested
}

enum DisputeType {
  skill_assessment
  validation_decision
}

enum DisputeStatus {
  open
  under_review
  upheld
  overturned
  dismissed
}

enum GitHubAccountIngestionStatus {
  pending
  in_progress
  completed
  failed
}

enum GitHubAppAccountType {
  user
  organization
}

enum GitHubAppRepositorySelection {
  selected
  all
}

enum GitHubAppInstallationStatus {
  active
  suspended
  deleted
  verification_failed
}

enum GitHubAppInstallationLinkStatus {
  active
  disconnected
  reauthorization_required
  revoked
}

enum GitHubAppLinkFlowType {
  install_and_authorize
  authorize_existing_installation
}

enum GitHubAppLinkStateStatus {
  issued
  callback_processed
  completed
  expired
  rejected
}

enum GitHubWebhookDeliveryStatus {
  received
  processed
  failed
  ignored
}

enum NotificationType {
  application_status
  skill_review
  delivery_update
  match_found
  task_recommendation
  plan_limit
  system
}

enum ReportReason {
  fraud
  misuse
  reputation_manipulation
  inaccurate_ai
  harassment
  other
}

enum ReportStatus {
  open
  investigating
  resolved
  dismissed
}

enum AiTraceAgentType {
  skill_profiling
  skill_validation
  skill_gap_guidance
  contributor_matching
}

enum AiTraceTriggerEntityType {
  user
  application
  contribution_request
}

enum AiTraceStatus {
  success
  partial
  failure
}

enum AiValidationDecision {
  eligible
  ineligible
  review_needed
}

enum SkillProfileStatus {
  pending
  approved
  rejected
  disputed
  superseded
}

enum SkillProfileGenerationStatus {
  queued
  collecting_evidence
  analyzing
  pending_review
  needs_more_evidence
  failed
}

enum SkillProfileProficiencyLevel {
  beginner
  intermediate
  advanced
}

enum SkillProfileReviewAction {
  approve
  reject
  adjust_proficiency
}

enum ReportedContentType {
  user
  project
  contribution_request
  application
  delivery
  skill_profile
}

enum UserActionType {
  order_created
  application_submitted
}

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  email              String       @unique @db.VarChar(255)
  username           String?      @unique @db.VarChar(30)
  password_hash      String?      @db.VarChar(255)
  first_name         String       @db.VarChar(100)
  last_name          String       @db.VarChar(100)
  avatar_url         String?      @db.VarChar(500)
  role               UserRole
  status             UserStatus   @default(pending)
  preferred_language LanguageCode @default(en)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @default(now()) @updatedAt
  last_login_at      DateTime?

  subscriptions                Subscription[]
  projects                     Project[]                     @relation("ProjectOwner")
  contributionRequests         ContributionRequest[]         @relation("ContributionRequestOwner")
  applications                 Application[]                 @relation("ApplicationContributor")
  notifications                Notification[]
  deliveryReviews              DeliveryReview[]              @relation("DeliveryReviewReviewer")
  disputesFiled                Dispute[]                     @relation("UserDisputesFiled")
  disputesResolved             Dispute[]                     @relation("UserDisputesResolved")
  githubAccount                GitHubAccount?
  contributorProfile           ContributorProfile?
  reputationRecord             ReputationRecord?
  skillProfiles                SkillProfile[]
  reviewedSkillProfiles        SkillProfile[]                @relation("SkillProfileReviewedBy")
  skillProfileReviewDecisions  SkillProfileReviewDecision[]  @relation("SkillProfileReviewDecisionReviewer")
  skillProfileGenerations      SkillProfileGeneration[]
  deliveries                   Delivery[]                    @relation("DeliveryContributor")
  aiMatchResults               AiMatchResult[]               @relation("AIMatchContributor")
  usageTrackers                UsageTracker[]
  reportsFiled                 Report[]                      @relation("ReportReporter")
  reportsResolved              Report[]                      @relation("ReportResolver")
  reportsReceived              Report[]                      @relation("ReportReportedUser")
  skillGapContributions        SkillGapGuidance[]            @relation("SkillGapContributor")
  authSessions                 AuthSession[]
  authProviderAccounts         AuthProviderAccount[]
  authOAuthStates              AuthOAuthState[]
  githubOAuthStates            GitHubOAuthState[]
  githubAppInstallationLinks   GitHubAppInstallationLink[]
  githubAppLinkStates          GitHubAppLinkState[]
  emailVerificationOtps        EmailVerificationOtp[]
  passwordResetOtps            PasswordResetOtp[]
  contributionRequestAudits    ContributionRequestAudit[]    @relation("ContributionRequestAuditActor")
  applicationAudits            ApplicationAudit[]            @relation("ApplicationAuditActor")
  applicationEvidenceSnapshots ApplicationEvidenceSnapshot[] @relation("ApplicationEvidenceSnapshotContributor")
}

model AuthProviderAccount {
  id                  String       @id @default(uuid()) @db.Uuid
  user_id             String       @db.Uuid
  provider            AuthProvider
  provider_account_id String       @map("provider_user_id") @db.VarChar(100)
  email               String?      @db.VarChar(255)
  email_verified      Boolean      @default(false)
  username            String?      @db.VarChar(100)
  avatar_url          String?      @db.VarChar(500)
  profile_url         String?      @db.VarChar(500)
  raw_profile_data    Json?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @default(now()) @updatedAt
  last_login_at       DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@unique([provider, user_id])
  @@index([user_id])
}

model AuthOAuthState {
  id             String       @id @default(uuid()) @db.Uuid
  user_id        String?      @db.Uuid
  provider       AuthProvider
  state_hash     String       @unique @db.VarChar(128)
  requested_role UserRole
  expires_at     DateTime
  consumed_at    DateTime?
  created_at     DateTime     @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([requested_role])
}

model EmailVerificationOtp {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  code_hash   String    @db.VarChar(128)
  expires_at  DateTime
  consumed_at DateTime?
  attempts    Int       @default(0)
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model PasswordResetOtp {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  code_hash   String    @db.VarChar(128)
  expires_at  DateTime
  consumed_at DateTime?
  attempts    Int       @default(0)
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model ContributorProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @unique @db.Uuid
  bio                 String?
  availability        String?  @db.VarChar(100)
  experience_level_id String?  @db.Uuid
  declared_skills     String[] @default([])
  avatar_data         Bytes?
  avatar_mime_type    String?  @db.VarChar(50)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  user             User                        @relation(fields: [user_id], references: [id])
  experience_level ContributorExperienceLevel? @relation(fields: [experience_level_id], references: [id], onDelete: SetNull)
  fields           ContributorProfileField[]

  @@index([user_id])
  @@index([experience_level_id])
}

model ContributorField {
  id         String                    @id @default(uuid()) @db.Uuid
  key        String                    @unique @db.VarChar(50)
  label_en   String                    @db.VarChar(100)
  label_ar   String                    @db.VarChar(100)
  active     Boolean                   @default(true)
  sort_order Int                       @default(0)
  created_at DateTime                  @default(now())
  updated_at DateTime                  @default(now()) @updatedAt
  profiles   ContributorProfileField[]

  @@index([active, sort_order])
}

model ContributorExperienceLevel {
  id         String               @id @default(uuid()) @db.Uuid
  key        String               @unique @db.VarChar(50)
  label_en   String               @db.VarChar(100)
  label_ar   String               @db.VarChar(100)
  active     Boolean              @default(true)
  sort_order Int                  @default(0)
  created_at DateTime             @default(now())
  updated_at DateTime             @default(now()) @updatedAt
  profiles   ContributorProfile[]

  @@index([active, sort_order])
}

model ContributorProfileField {
  profile_id String   @db.Uuid
  field_id   String   @db.Uuid
  created_at DateTime @default(now())

  profile ContributorProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  field   ContributorField   @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@id([profile_id, field_id])
  @@index([field_id])
}

model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  access_token_hash  String    @unique @db.VarChar(128)
  refresh_token_hash String    @unique @db.VarChar(128)
  user_agent         String?   @db.VarChar(500)
  ip_address         String?   @db.VarChar(45)
  expires_at         DateTime
  refresh_expires_at DateTime
  revoked_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model GitHubOAuthState {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  state_hash  String    @unique @db.VarChar(128)
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Subscription {
  id                String                      @id @default(uuid()) @db.Uuid
  user_id           String                      @db.Uuid
  plan_type         SubscriptionPlanType
  user_role_context SubscriptionUserRoleContext
  status            SubscriptionStatus          @default(active)
  starts_at         DateTime
  expires_at        DateTime?
  cancelled_at      DateTime?
  created_at        DateTime                    @default(now())
  updated_at        DateTime                    @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model Project {
  id                    String             @id @default(uuid()) @db.Uuid
  owner_id              String             @db.Uuid
  title                 String             @db.VarChar(255)
  slug                  String             @db.VarChar(80)
  slug_normalized       String             @db.VarChar(80)
  description           String?
  github_repo_url       String             @db.VarChar(500)
  github_repo_id        String?            @db.VarChar(50)
  languages             Json?
  tags                  Json?
  technologies          Json?
  repo_statistics       Json?
  category              ProjectCategory?
  difficulty            ProjectDifficulty?
  status                ProjectStatus      @default(draft)
  readme_content        String?
  revision              Int                @default(1)
  manual_overrides      Json               @default("[]")
  source_visibility     String?            @db.VarChar(20)
  source_owner_id       String?            @db.VarChar(50)
  source_owner_type     String?            @db.VarChar(20)
  source_default_branch String?            @db.VarChar(255)
  source_updated_at     DateTime?
  source_fetched_at     DateTime?
  published_at          DateTime?
  archived_at           DateTime?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @default(now()) @updatedAt

  owner                User                     @relation("ProjectOwner", fields: [owner_id], references: [id])
  contributionRequests ContributionRequest[]
  operations           ProjectOperation[]
  stateTransitions     ProjectStateTransition[]

  @@unique([slug_normalized], map: "projects_slug_normalized_unique")
  @@index([github_repo_url])
  @@index([github_repo_id, status])
}

model ProjectOperation {
  id           String   @id @default(uuid()) @db.Uuid
  project_id   String?  @db.Uuid
  actor_id     String   @db.Uuid
  operation    String   @db.VarChar(40)
  key_hash     String   @db.VarChar(64)
  request_hash String   @db.VarChar(64)
  response     Json?
  created_at   DateTime @default(now())

  project Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([actor_id, operation, key_hash])
  @@index([created_at])
}

model ProjectStateTransition {
  id                 String        @id @default(uuid()) @db.Uuid
  project_id         String        @db.Uuid
  actor_id           String        @db.Uuid
  from_status        ProjectStatus
  to_status          ProjectStatus
  validation_outcome Json
  created_at         DateTime      @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, created_at])
  @@index([actor_id])
}

model ContributionRequest {
  id                     String                         @id @default(uuid()) @db.Uuid
  project_id             String                         @db.Uuid
  owner_id               String                         @db.Uuid
  title                  String                         @db.VarChar(255)
  description            String
  technology_tags        Json                           @default("[]")
  difficulty             ContributionRequestDifficulty?
  applications_close_at  DateTime?
  target_completion_date DateTime?                      @db.Date
  reward                 Decimal?                       @db.Decimal(10, 2)
  reward_currency        String?                        @db.VarChar(3)
  status                 ContributionRequestStatus      @default(draft)
  max_applicants         Int                            @default(1)
  published_at           DateTime?
  created_at             DateTime                       @default(now())
  updated_at             DateTime                       @default(now()) @updatedAt

  project           Project                          @relation(fields: [project_id], references: [id])
  owner             User                             @relation("ContributionRequestOwner", fields: [owner_id], references: [id])
  requirements      ContributionRequestRequirement[]
  auditEvents       ContributionRequestAudit[]
  applications      Application[]
  aiMatchResults    AiMatchResult[]
  skillGapGuidances SkillGapGuidance[]
  deliveries        Delivery[]

  @@index([project_id, status])
  @@index([owner_id, created_at])
  @@index([status, applications_close_at, published_at])
}

model ContributionRequestRequirement {
  id                      String                             @id @default(uuid()) @db.Uuid
  contribution_request_id String                             @db.Uuid
  kind                    ContributionRequestRequirementKind
  position                Int
  text                    String                             @db.VarChar(500)
  created_at              DateTime                           @default(now())

  contributionRequest ContributionRequest @relation(fields: [contribution_request_id], references: [id], onDelete: Cascade)

  @@unique([contribution_request_id, kind, position])
  @@index([contribution_request_id, kind])
}

model ContributionRequestAudit {
  id                      String                         @id @default(uuid()) @db.Uuid
  contribution_request_id String                         @db.Uuid
  actor_id                String                         @db.Uuid
  action                  ContributionRequestAuditAction
  from_status             ContributionRequestStatus?
  to_status               ContributionRequestStatus
  reason                  String?                        @db.VarChar(500)
  payload_version         Int                            @default(1)
  idempotency_key         String?                        @db.VarChar(128)
  command_fingerprint     String?                        @db.Char(64)
  metadata                Json?
  created_at              DateTime                       @default(now())

  contributionRequest ContributionRequest @relation(fields: [contribution_request_id], references: [id], onDelete: Restrict)
  actor               User                @relation("ContributionRequestAuditActor", fields: [actor_id], references: [id], onDelete: Restrict)

  @@unique([actor_id, action, idempotency_key])
  @@index([contribution_request_id, created_at])
}

model Application {
  id                              String            @id @default(uuid()) @db.Uuid
  contribution_request_id         String            @db.Uuid
  contributor_id                  String            @db.Uuid
  cover_message                   String?
  contribution_approach           String?
  proposed_delivery_duration_days Int?
  requirement_snapshot_id         String?           @unique @db.Uuid
  evidence_snapshot_id            String?           @unique @db.Uuid
  status                          ApplicationStatus @default(pending_owner_review)
  is_priority                     Boolean           @default(false)
  submitted_at                    DateTime
  validated_at                    DateTime?
  owner_reviewed_at               DateTime?
  review_due_at                   DateTime?
  expires_at                      DateTime?
  expired_at                      DateTime?
  created_at                      DateTime          @default(now())
  updated_at                      DateTime          @default(now()) @updatedAt

  contributionRequest ContributionRequest             @relation(fields: [contribution_request_id], references: [id])
  contributor         User                            @relation("ApplicationContributor", fields: [contributor_id], references: [id])
  requirementSnapshot ApplicationRequirementSnapshot? @relation(fields: [requirement_snapshot_id], references: [id], onDelete: Restrict)
  evidenceSnapshot    ApplicationEvidenceSnapshot?    @relation(fields: [evidence_snapshot_id], references: [id], onDelete: Restrict)
  auditEvents         ApplicationAudit[]
  aiValidationResult  AiValidationResult?
  delivery            Delivery?
  skillGapGuidance    SkillGapGuidance?

  @@unique([contribution_request_id, contributor_id])
  @@index([contribution_request_id, status, submitted_at])
  @@index([contributor_id, submitted_at])
}

model ApplicationRequirementSnapshot {
  id                        String   @id @default(uuid()) @db.Uuid
  contribution_request_id   String   @db.Uuid
  source_request_updated_at DateTime
  requirements              Json
  created_at                DateTime @default(now())

  application Application?

  @@index([contribution_request_id])
}

model ApplicationEvidenceSnapshot {
  id                  String   @id @default(uuid()) @db.Uuid
  contributor_id      String   @db.Uuid
  contributor_context Json
  evidence            Json
  created_at          DateTime @default(now())

  contributor User         @relation("ApplicationEvidenceSnapshotContributor", fields: [contributor_id], references: [id], onDelete: Restrict)
  application Application?

  @@index([contributor_id, created_at])
}

model ApplicationAudit {
  id                  String                 @id @default(uuid()) @db.Uuid
  application_id      String                 @db.Uuid
  actor_id            String                 @db.Uuid
  action              ApplicationAuditAction
  from_status         ApplicationStatus?
  to_status           ApplicationStatus
  idempotency_key     String?                @db.VarChar(128)
  command_fingerprint String?                @db.Char(64)
  metadata            Json?
  created_at          DateTime               @default(now())

  application Application @relation(fields: [application_id], references: [id], onDelete: Restrict)
  actor       User        @relation("ApplicationAuditActor", fields: [actor_id], references: [id], onDelete: Restrict)

  @@unique([actor_id, action, idempotency_key])
  @@index([application_id, created_at])
}

model AiValidationResult {
  id                 String               @id @default(uuid()) @db.Uuid
  application_id     String               @unique @db.Uuid
  decision           AiValidationDecision
  confidence_score   Float
  justification      String
  matched_skills     Json?
  missing_skills     Json?
  source_attribution Json?
  model_used         String?              @db.VarChar(50)
  latency_ms         Int?
  created_at         DateTime             @default(now())

  application Application @relation(fields: [application_id], references: [id])
  dispute     Dispute?    @relation("DisputeAiValidationResult")
}

model AiMatchResult {
  id                      String   @id @default(uuid()) @db.Uuid
  contribution_request_id String   @db.Uuid
  contributor_id          String   @db.Uuid
  match_score             Float
  justification           String?
  matched_skills          Json?
  reputation_signals      Json?
  source_attribution      Json?
  rank                    Int
  model_used              String?  @db.VarChar(50)
  notification_sent       Boolean  @default(false)
  created_at              DateTime @default(now())

  contributionRequest ContributionRequest @relation(fields: [contribution_request_id], references: [id])
  contributor         User                @relation("AIMatchContributor", fields: [contributor_id], references: [id])
}

model AiTraceLog {
  id                  String                   @id @default(uuid()) @db.Uuid
  agent_type          AiTraceAgentType
  trigger_entity_id   String                   @db.Uuid
  trigger_entity_type AiTraceTriggerEntityType
  input_payload       Json?
  output_payload      Json?
  confidence_score    Float?
  model_used          String?                  @db.VarChar(50)
  prompt_tokens       Int?
  completion_tokens   Int?
  latency_ms          Int?
  status              AiTraceStatus
  error_message       String?
  retrieved_sources   Json?
  created_at          DateTime                 @default(now())
}

model Delivery {
  id                      String         @id @default(uuid()) @db.Uuid
  application_id          String         @unique @db.Uuid
  contribution_request_id String         @db.Uuid
  contributor_id          String         @db.Uuid
  pr_url                  String         @db.VarChar(500)
  contributor_notes       String?
  status                  DeliveryStatus @default(submitted)
  submitted_at            DateTime
  reviewed_at             DateTime?
  created_at              DateTime       @default(now())
  updated_at              DateTime       @default(now()) @updatedAt

  application         Application         @relation(fields: [application_id], references: [id])
  contributionRequest ContributionRequest @relation(fields: [contribution_request_id], references: [id])
  contributor         User                @relation("DeliveryContributor", fields: [contributor_id], references: [id])
  deliveryReview      DeliveryReview?
}

model DeliveryReview {
  id          String                @id @default(uuid()) @db.Uuid
  delivery_id String                @unique @db.Uuid
  reviewer_id String                @db.Uuid
  rating      Int
  feedback    String?
  outcome     DeliveryReviewOutcome
  created_at  DateTime              @default(now())

  delivery Delivery @relation(fields: [delivery_id], references: [id])
  reviewer User     @relation("DeliveryReviewReviewer", fields: [reviewer_id], references: [id])
}

model Dispute {
  id                      String        @id @default(uuid()) @db.Uuid
  user_id                 String        @db.Uuid
  skill_profile_id        String?       @db.Uuid
  ai_validation_result_id String?       @unique @db.Uuid
  type                    DisputeType
  reason                  String
  evidence                String?
  status                  DisputeStatus @default(open)
  resolved_by             String?       @db.Uuid
  resolution_notes        String?
  resolved_at             DateTime?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @default(now()) @updatedAt

  user               User                @relation("UserDisputesFiled", fields: [user_id], references: [id])
  skillProfile       SkillProfile?       @relation(fields: [skill_profile_id], references: [id])
  aiValidationResult AiValidationResult? @relation("DisputeAiValidationResult", fields: [ai_validation_result_id], references: [id])
  resolvedBy         User?               @relation("UserDisputesResolved", fields: [resolved_by], references: [id])
}

model GitHubAccount {
  id               String                       @id @default(uuid()) @db.Uuid
  user_id          String                       @unique @db.Uuid
  github_id        String                       @unique @db.VarChar(50)
  username         String                       @db.VarChar(100)
  access_token     String?                      @db.VarChar(500)
  refresh_token    String?                      @db.VarChar(500)
  avatar_url       String?                      @db.VarChar(500)
  profile_url      String?                      @db.VarChar(500)
  raw_profile_data Json?
  ingestion_status GitHubAccountIngestionStatus @default(pending)
  token_expires_at DateTime?
  connected_at     DateTime
  last_synced_at   DateTime?

  user User @relation(fields: [user_id], references: [id])
}

model GitHubAppInstallation {
  id                   String                       @id @default(uuid()) @db.Uuid
  installation_id      String                       @unique @db.VarChar(50)
  account_id           String                       @db.VarChar(50)
  account_login        String                       @db.VarChar(100)
  account_type         GitHubAppAccountType
  repository_selection GitHubAppRepositorySelection
  permissions          Json
  status               GitHubAppInstallationStatus  @default(verification_failed)
  installed_at         DateTime
  last_verified_at     DateTime?
  suspended_at         DateTime?
  deleted_at           DateTime?
  created_at           DateTime                     @default(now())
  updated_at           DateTime                     @default(now()) @updatedAt

  links        GitHubAppInstallationLink[]
  repositories GitHubAppRepository[]
  linkStates   GitHubAppLinkState[]

  @@index([account_id])
  @@index([status])
}

model GitHubAppInstallationLink {
  id                       String                          @id @default(uuid()) @db.Uuid
  installation_id          String                          @db.Uuid
  user_id                  String                          @db.Uuid
  github_user_id           String                          @db.VarChar(50)
  github_login             String                          @db.VarChar(100)
  encrypted_user_token     String?                         @db.Text
  user_token_expires_at    DateTime?
  encrypted_refresh_token  String?                         @db.Text
  refresh_token_expires_at DateTime?
  status                   GitHubAppInstallationLinkStatus @default(active)
  last_verified_at         DateTime?
  linked_at                DateTime                        @default(now())
  disconnected_at          DateTime?
  revoked_at               DateTime?
  created_at               DateTime                        @default(now())
  updated_at               DateTime                        @default(now()) @updatedAt

  installation GitHubAppInstallation    @relation(fields: [installation_id], references: [id], onDelete: Restrict)
  user         User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  generations  SkillProfileGeneration[]

  @@unique([installation_id, user_id])
  @@index([user_id, status])
  @@index([github_user_id])
}

model GitHubAppRepository {
  id                   String    @id @default(uuid()) @db.Uuid
  installation_id      String    @db.Uuid
  github_repository_id String    @db.VarChar(50)
  full_name            String    @db.VarChar(255)
  visibility           String    @db.VarChar(20)
  default_branch       String?   @db.VarChar(255)
  selected_at          DateTime  @default(now())
  last_verified_at     DateTime
  removed_at           DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @default(now()) @updatedAt

  installation GitHubAppInstallation @relation(fields: [installation_id], references: [id], onDelete: Cascade)

  @@unique([installation_id, github_repository_id])
  @@index([installation_id, removed_at])
}

model GitHubAppLinkState {
  id                                 String                   @id @default(uuid()) @db.Uuid
  user_id                            String                   @db.Uuid
  flow_type                          GitHubAppLinkFlowType
  target_installation_id             String?                  @db.Uuid
  state_hash                         String                   @unique @db.VarChar(128)
  status                             GitHubAppLinkStateStatus @default(issued)
  expires_at                         DateTime
  callback_consumed_at               DateTime?
  completion_consumed_at             DateTime?
  verified_github_user_id            String?                  @db.VarChar(50)
  verified_github_login              String?                  @db.VarChar(100)
  accessible_installation_candidates Json?
  encrypted_pending_user_token       String?                  @db.Text
  pending_user_token_expires_at      DateTime?
  encrypted_pending_refresh_token    String?                  @db.Text
  pending_refresh_token_expires_at   DateTime?
  failure_code                       String?                  @db.VarChar(100)
  created_at                         DateTime                 @default(now())
  updated_at                         DateTime                 @default(now()) @updatedAt

  user               User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  targetInstallation GitHubAppInstallation? @relation(fields: [target_installation_id], references: [id], onDelete: SetNull)

  @@index([user_id, status])
  @@index([expires_at])
}

model GitHubWebhookDelivery {
  id                       String                      @id @default(uuid()) @db.Uuid
  delivery_id              String                      @unique @db.VarChar(100)
  event                    String                      @db.VarChar(100)
  action                   String?                     @db.VarChar(100)
  provider_installation_id String?                     @db.VarChar(50)
  status                   GitHubWebhookDeliveryStatus @default(received)
  retry_count              Int                         @default(0)
  safe_error_code          String?                     @db.VarChar(100)
  received_at              DateTime                    @default(now())
  processed_at             DateTime?

  @@index([provider_installation_id])
  @@index([status])
}

model GitHubEvidenceCutover {
  id                                  String    @id @default("github-evidence") @db.VarChar(50)
  cutover_at                          DateTime?
  executed_by                         String?   @db.VarChar(100)
  legacy_credentials_purged_at        DateTime?
  provider_revocation_succeeded_count Int       @default(0)
  provider_revocation_failed_count    Int       @default(0)
  legacy_evidence_cleanup_due_at      DateTime?
  legacy_evidence_cleaned_at          DateTime?
  last_error_code                     String?   @db.VarChar(100)
  created_at                          DateTime  @default(now())
  updated_at                          DateTime  @default(now()) @updatedAt
}

model Notification {
  id                String           @id @default(uuid()) @db.Uuid
  user_id           String           @db.Uuid
  type              NotificationType
  title             String           @db.VarChar(255)
  message           String
  metadata          Json?
  deduplication_key String?          @unique @db.VarChar(160)
  is_read           Boolean          @default(false)
  read_at           DateTime?
  created_at        DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model Report {
  id                    String               @id @default(uuid()) @db.Uuid
  reporter_id           String               @db.Uuid
  reported_user_id      String?              @db.Uuid
  reported_content_id   String?              @db.Uuid
  reported_content_type ReportedContentType?
  reason                ReportReason
  description           String
  status                ReportStatus         @default(open)
  resolved_by           String?              @db.Uuid
  resolution_notes      String?
  resolved_at           DateTime?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @default(now()) @updatedAt

  reporter     User  @relation("ReportReporter", fields: [reporter_id], references: [id])
  reportedUser User? @relation("ReportReportedUser", fields: [reported_user_id], references: [id])
  resolvedBy   User? @relation("ReportResolver", fields: [resolved_by], references: [id])
}

model ReputationRecord {
  id                       String   @id @default(uuid()) @db.Uuid
  user_id                  String   @unique @db.Uuid
  overall_rating           Float?
  total_contributions      Int      @default(0)
  successful_contributions Int      @default(0)
  success_rate             Float    @default(0.0)
  top_verified_skills      Json?
  total_ratings_received   Int      @default(0)
  last_updated_at          DateTime @default(now())
  created_at               DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model SkillGapGuidance {
  id                         String   @id @default(uuid()) @db.Uuid
  application_id             String   @unique @db.Uuid
  contributor_id             String   @db.Uuid
  contribution_request_id    String   @db.Uuid
  missing_skills             Json
  recommended_technologies   Json?
  learning_resources         Json?
  practice_projects          Json?
  estimated_improvement_time String?  @db.VarChar(50)
  guidance_narrative         String?
  source_attribution         Json?
  model_used                 String?  @db.VarChar(50)
  created_at                 DateTime @default(now())

  application         Application         @relation(fields: [application_id], references: [id])
  contributor         User                @relation("SkillGapContributor", fields: [contributor_id], references: [id])
  contributionRequest ContributionRequest @relation(fields: [contribution_request_id], references: [id])
}

model SkillProfile {
  id                   String                        @id @default(uuid()) @db.Uuid
  user_id              String                        @db.Uuid
  generation_id        String?                       @db.Uuid
  skill_name           String                        @db.VarChar(100)
  skill_key            String?                       @db.VarChar(100)
  proficiency_level    SkillProfileProficiencyLevel
  confidence_score     Float
  evidence_summary     String?
  evidence_sources     Json?
  status               SkillProfileStatus            @default(pending)
  reviewed_by          String?                       @db.Uuid
  admin_notes          String?
  original_proficiency SkillProfileProficiencyLevel?
  reviewed_at          DateTime?
  superseded_at        DateTime?
  created_at           DateTime                      @default(now())
  updated_at           DateTime                      @default(now()) @updatedAt

  user            User                         @relation(fields: [user_id], references: [id])
  generation      SkillProfileGeneration?      @relation(fields: [generation_id], references: [id])
  reviewedBy      User?                        @relation("SkillProfileReviewedBy", fields: [reviewed_by], references: [id])
  reviewDecisions SkillProfileReviewDecision[]
  disputes        Dispute[]

  @@index([user_id])
  @@index([generation_id])
  @@index([user_id, skill_key])
  @@index([status])
}

model SkillProfileReviewDecision {
  id                   String                        @id @default(uuid()) @db.Uuid
  skill_profile_id     String                        @db.Uuid
  reviewer_id          String                        @db.Uuid
  action               SkillProfileReviewAction
  previous_status      SkillProfileStatus
  new_status           SkillProfileStatus
  previous_proficiency SkillProfileProficiencyLevel?
  new_proficiency      SkillProfileProficiencyLevel?
  notes                String?
  created_at           DateTime                      @default(now())

  skillProfile SkillProfile @relation(fields: [skill_profile_id], references: [id])
  reviewer     User         @relation("SkillProfileReviewDecisionReviewer", fields: [reviewer_id], references: [id])

  @@index([skill_profile_id])
  @@index([reviewer_id])
  @@index([action])
}

model SkillProfileGeneration {
  id                              String                       @id @default(uuid()) @db.Uuid
  user_id                         String                       @db.Uuid
  status                          SkillProfileGenerationStatus @default(queued)
  selected_repositories           Json
  evidence_snapshot               Json?
  fraud_signals                   Json?
  evidence_quality                String?                      @db.VarChar(20)
  failure_reason                  String?
  provider                        String?                      @db.VarChar(50)
  model                           String?                      @db.VarChar(100)
  prompt_version                  String?                      @db.VarChar(100)
  schema_version                  String?                      @db.VarChar(100)
  service_version                 String?                      @db.VarChar(100)
  selected_repository_count       Int                          @default(0)
  snapshotted_repository_count    Int                          @default(0)
  github_app_installation_link_id String?                      @db.Uuid
  provider_installation_id        String?                      @db.VarChar(50)
  consent_version                 String?                      @db.VarChar(100)
  consented_at                    DateTime?
  authorization_verified_at       DateTime?
  authorization_failure_code      String?                      @db.VarChar(100)
  retry_of_generation_id          String?                      @db.Uuid
  created_at                      DateTime                     @default(now())
  updated_at                      DateTime                     @default(now()) @updatedAt
  completed_at                    DateTime?

  user                      User                       @relation(fields: [user_id], references: [id])
  skillProfiles             SkillProfile[]
  githubAppInstallationLink GitHubAppInstallationLink? @relation(fields: [github_app_installation_link_id], references: [id], onDelete: SetNull)
  retryOf                   SkillProfileGeneration?    @relation("SkillProfileGenerationRetries", fields: [retry_of_generation_id], references: [id], onDelete: SetNull)
  retries                   SkillProfileGeneration[]   @relation("SkillProfileGenerationRetries")

  @@index([user_id])
  @@index([status])
  @@index([github_app_installation_link_id])
  @@index([retry_of_generation_id])
}

model UsageTracker {
  id          String         @id @default(uuid()) @db.Uuid
  user_id     String         @db.Uuid
  action_type UserActionType
  period_date DateTime       @db.Date
  count       Int            @default(0)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id])
}
