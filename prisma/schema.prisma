model SkillProfileGeneration {
  id                              String                       @id @default(uuid()) @db.Uuid
  user_id                         String                       @db.Uuid
  status                          SkillProfileGenerationStatus @default(queued)
  selected_repositories           Json
  evidence_snapshot               Json?
  fraud_signals                   Json?
  evidence_quality                String?                      @db.VarChar(20)
  failure_reason                  String?
  provider                        String?                      @db.VarChar(50)
  model                           String?                      @db.VarChar(100)
  prompt_version                  String?                      @db.VarChar(100)
  schema_version                  String?                      @db.VarChar(100)
  service_version                 String?                      @db.VarChar(100)
  selected_repository_count       Int                          @default(0)
  snapshotted_repository_count    Int                          @default(0)
  github_app_installation_link_id String?                      @db.Uuid
  provider_installation_id        String?                      @db.VarChar(50)
  consent_version                 String?                      @db.VarChar(100)
  consented_at                    DateTime?
  authorization_verified_at       DateTime?
  authorization_failure_code      String?                      @db.VarChar(100)
  retry_of_generation_id          String?                      @db.Uuid
  created_at                      DateTime                     @default(now())
  updated_at                      DateTime                     @default(now()) @updatedAt
  completed_at                    DateTime?

  user                      User                       @relation(fields: [user_id], references: [id])
  skillProfiles             SkillProfile[]
  githubAppInstallationLink GitHubAppInstallationLink? @relation(fields: [github_app_installation_link_id], references: [id], onDelete: SetNull)
  retryOf                   SkillProfileGeneration?    @relation("SkillProfileGenerationRetries", fields: [retry_of_generation_id], references: [id], onDelete: SetNull)
  retries                   SkillProfileGeneration[]   @relation("SkillProfileGenerationRetries")

  @@index([user_id])
  @@index([status])
  @@index([github_app_installation_link_id])
  @@index([retry_of_generation_id])
}

model UsageTracker {
  id          String         @id @default(uuid()) @db.Uuid
  user_id     String         @db.Uuid
  action_type UserActionType
  period_date DateTime       @db.Date
  count       Int            @default(0)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id])

  // One tally per user, action and period. The advisory lock serializes a
  // contributor's concurrent submissions, but the counter is the thing a quota
  // is actually made of, so uniqueness is enforced by the database rather than
  // by whoever remembers to take the lock.
  @@unique([user_id, action_type, period_date])
}

enum MaterialVisibility {
  public
  restricted_project
  assignment
}

enum MaterialScanStatus {
  quarantined
  scanning
  ready
  rejected
}

enum MaterialAuditAction {
  uploaded
  scan_started
  scan_cleared
  scan_rejected
  scan_abandoned
  visibility_changed
  grant_added
  grant_revoked
  deleted
  purged
}

enum MaterialAnalysisPurpose {
  project_material_drafting
}

enum MaterialAnalysisSetStatus {
  draft
  running
  completed
  failed
}

enum MaterialAnalysisRunStatus {
  requested
  running
  completed
  failed
}

enum MaterialDraftSuggestionType {
  project_update
  contribution_request
}

enum MaterialDraftSuggestionStatus {
  pending
  accepted
  rejected
}

/// A Material belongs to exactly one of a Project or a Contribution Request.
/// Content lives in immutable MaterialVersions; this row carries identity,
/// ownership scope, and the server-enforced visibility class.
model Material {
  id                      String             @id @default(uuid()) @db.Uuid
  project_id              String?            @db.Uuid
  contribution_request_id String?            @db.Uuid
  owner_id                String             @db.Uuid
  title                   String             @db.VarChar(255)
  visibility              MaterialVisibility
  current_version         Int                @default(0)
  deleted_at              DateTime?
  created_at              DateTime           @default(now())
  updated_at              DateTime           @default(now()) @updatedAt

  project             Project?                     @relation("ProjectMaterials", fields: [project_id], references: [id], onDelete: Restrict)
  contributionRequest ContributionRequest?         @relation("ContributionRequestMaterials", fields: [contribution_request_id], references: [id], onDelete: Restrict)
  owner               User                         @relation("MaterialOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  versions            MaterialVersion[]
  analysisSetVersions MaterialAnalysisSetVersion[]
  grants              MaterialGrant[]
  auditEvents         MaterialAudit[]

  @@index([project_id, deleted_at])
  @@index([contribution_request_id, deleted_at])
  @@index([owner_id])
}

/// An owner-created, version-fixed scope for one explicit Material analysis.
/// Creating the set stores no document bytes and does not call the AI service.
model MaterialAnalysisSet {
  id         String                    @id @default(uuid()) @db.Uuid
  project_id String                    @db.Uuid
  owner_id   String                    @db.Uuid
  purpose    MaterialAnalysisPurpose
  status     MaterialAnalysisSetStatus @default(draft)
  created_at DateTime                  @default(now())
  updated_at DateTime                  @updatedAt

  project  Project                      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  owner    User                         @relation("MaterialAnalysisSetOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  versions MaterialAnalysisSetVersion[]
  runs     MaterialAnalysisRun[]
  chunks   MaterialAnalysisChunk[]

  @@index([project_id, created_at])
  @@index([owner_id, created_at])
}

/// Exact version snapshot. The filename, MIME type, and content hash are
/// retained so a later Material replacement cannot change what a Run meant.
model MaterialAnalysisSetVersion {
  id                String   @id @default(uuid()) @db.Uuid
  analysis_set_id   String   @db.Uuid
  material_id       String   @db.Uuid
  material_version  Int
  original_filename String   @db.VarChar(255)
  mime_type         String   @db.VarChar(150)
  content_hash      String   @db.Char(64)
  created_at        DateTime @default(now())

  analysisSet MaterialAnalysisSet @relation(fields: [analysis_set_id], references: [id], onDelete: Cascade)
  material    Material            @relation(fields: [material_id], references: [id], onDelete: Restrict)

  @@unique([analysis_set_id, material_id, material_version])
  @@index([material_id, material_version])
}

/// One explicit execution over one Analysis Set. AI metadata is technical
/// audit data; suggestions remain private until the owner reviews them.
model MaterialAnalysisRun {
  id                   String                    @id @default(uuid()) @db.Uuid
  analysis_set_id      String                    @db.Uuid
  contract_version     String                    @db.VarChar(100)
  status               MaterialAnalysisRunStatus @default(requested)
  provider             String?                   @db.VarChar(100)
  model                String?                   @db.VarChar(150)
  prompt_version       String?                   @db.VarChar(100)
  schema_version       String?                   @db.VarChar(100)
  service_version      String?                   @db.VarChar(100)
  document_count       Int?
  extracted_characters Int?
  error_code           String?                   @db.VarChar(100)
  started_at           DateTime?
  completed_at         DateTime?
  created_at           DateTime                  @default(now())
  updated_at           DateTime                  @updatedAt

  analysisSet MaterialAnalysisSet       @relation(fields: [analysis_set_id], references: [id], onDelete: Cascade)
  suggestions MaterialDraftSuggestion[]
  chunks      MaterialAnalysisChunk[]

  @@index([analysis_set_id, created_at])
  @@index([status, updated_at])
}

/// A typed, provenance-carrying draft. `payload` is deliberately not a
/// Project or ContributionRequest row: review/adoption is a separate command.
model MaterialDraftSuggestion {
  id                  String                        @id @default(uuid()) @db.Uuid
  run_id              String                        @db.Uuid
  suggestion_type     MaterialDraftSuggestionType
  target_field        String?                       @db.VarChar(50)
  payload             Json
  rationale           String                        @db.VarChar(2000)
  source_versions     Json
  status              MaterialDraftSuggestionStatus @default(pending)
  reviewed_by         String?                       @db.Uuid
  reviewed_at         DateTime?
  source_removed_at   DateTime?
  adopted_entity_type String?                       @db.VarChar(50)
  adopted_entity_id   String?                       @db.Uuid
  created_at          DateTime                      @default(now())
  updated_at          DateTime                      @updatedAt

  run        MaterialAnalysisRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("MaterialDraftSuggestionReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([run_id, status, created_at])
}

/// Request-scoped retrieval chunks. The text and vector are deleted when the
/// source Material is deleted; the Run and suggestion audit remain.
model MaterialAnalysisChunk {
  id               String                @id @default(uuid()) @db.Uuid
  run_id           String                @db.Uuid
  analysis_set_id  String                @db.Uuid
  material_id      String                @db.Uuid
  material_version Int
  chunk_index      Int
  text             String
  character_start  Int?
  character_end    Int?
  embedding        Unsupported("vector")
  created_at       DateTime              @default(now())

  run         MaterialAnalysisRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  analysisSet MaterialAnalysisSet @relation(fields: [analysis_set_id], references: [id], onDelete: Cascade)

  @@unique([run_id, material_id, material_version, chunk_index])
  @@index([analysis_set_id, material_id, material_version])
}

/// Immutable. A replacement is a new version, never an edit. Content is
/// unreadable until scan_status is `ready`, and purging clears the bytes while
/// the row survives as audit metadata.
model MaterialVersion {
  id                String             @id @default(uuid()) @db.Uuid
  material_id       String             @db.Uuid
  version           Int
  storage_key       String             @db.VarChar(512)
  content_hash      String             @db.Char(64)
  byte_size         Int
  mime_type         String             @db.VarChar(150)
  original_filename String             @db.VarChar(255)
  scan_status       MaterialScanStatus @default(quarantined)
  scan_error_code   String?            @db.VarChar(100)
  scanned_at        DateTime?
  uploaded_by       String             @db.Uuid
  purged_at         DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @default(now()) @updatedAt

  material   Material @relation(fields: [material_id], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("MaterialVersionUploader", fields: [uploaded_by], references: [id], onDelete: Restrict)

  @@unique([material_id, version])
  @@index([scan_status, updated_at])
}

/// An explicit, revocable grant for restricted_project Materials. Absence of a
/// live grant denies access; a revoked grant is retained rather than deleted so
/// the history stays auditable.
model MaterialGrant {
  id          String    @id @default(uuid()) @db.Uuid
  material_id String    @db.Uuid
  grantee_id  String    @db.Uuid
  granted_by  String    @db.Uuid
  granted_at  DateTime  @default(now())
  revoked_at  DateTime?
  revoked_by  String?   @db.Uuid

  material  Material @relation(fields: [material_id], references: [id], onDelete: Restrict)
  grantee   User     @relation("MaterialGrantGrantee", fields: [grantee_id], references: [id], onDelete: Restrict)
  grantedBy User     @relation("MaterialGrantGranter", fields: [granted_by], references: [id], onDelete: Restrict)

  @@index([material_id, grantee_id, revoked_at])
  @@index([grantee_id, revoked_at])
}

/// Append-only. Survives version purge deliberately: deletion removes content,
/// not the record that content once existed and who acted on it.
model MaterialAudit {
  id                  String              @id @default(uuid()) @db.Uuid
  material_id         String              @db.Uuid
  material_version    Int?
  actor_id            String?             @db.Uuid
  action              MaterialAuditAction
  from_status         MaterialScanStatus?
  to_status           MaterialScanStatus?
  idempotency_key     String?             @db.VarChar(128)
  command_fingerprint String?             @db.Char(64)
  metadata            Json?
  created_at          DateTime            @default(now())

  material Material @relation(fields: [material_id], references: [id], onDelete: Restrict)
  actor    User?    @relation("MaterialAuditActor", fields: [actor_id], references: [id], onDelete: Restrict)

  @@unique([actor_id, action, idempotency_key])
  @@index([material_id, created_at])
}
